{
  "headers": [
    {
      "source": "/((?!api/|assets/|images/|favicon.svg|icons.svg|.*\\..*).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://pickpackpro-backend.vercel.app/api/$1"
    },
    {
      "source": "/((?!assets/|images/|favicon.svg|icons.svg|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
